    "import numpy as np\n",
    "from scipy import linalg as la\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#30x30 square lattices so we have 900 sins in 1 lattice and 1000 sample\n",
    "\n",
    "#upload data, use AI some of the format was off \n",
    "directory = \"/Users/lilly-anne/Desktop/ap3751-2026-kalderen\"\n",
    "config_ising = np.load(f\"{directory}/ising_training_configs_30x30.npy\", allow_pickle=True)\n",
    "label_ising = np.load(f\"{directory}/ising_training_labels_30x30.npy\", allow_pickle=True)\n",
    "\n",
    "#Reshape to get the 1000 samples each with 900 pixels double checked with AI that this was done correctly \n",
    "config_reshape = config_ising.reshape(config_ising.shape[0], -1) \n",
    "\n",
    "#Start by standardizing the data \n",
    "mean_config = np.mean(config_reshape,axis=0)\n",
    "config_standard_dev= np.std(config_reshape,axis=0)\n",
    "config_standardized = (config_reshape - mean_config)/config_standard_dev\n",
    "\n",
    "#Calculate the covariance matrix and eigenvalues\n",
    "cov_matrix = np.cov(config_standardized,rowvar=False,dtype=None) \n",
    "eigen_vals, eigen_vecs = la.eigh(cov_matrix)\n",
    "index  = np.argsort(eigen_vals)[::-1] #reindex so that we get the eigen values and vectors from high to low\n",
    "eiegen_vals = eigen_vals[index]\n",
    "eigen_vecs = eigen_vecs[:, index]\n",
    "\n",
    "proj_matrix = eigen_vecs[:,:2] #The two eigen vectors corresponding to the highest eigenvalues used as PCAs. Checked and corrected with AI that the projection matrix was correct\n",
    "\n",
    "ising_proj = np.dot(config_standardized,proj_matrix) #Apply the projection\n",
    "\n",
    "\n",
    "#AI used to make the plots pretty\n",
    "plt.scatter(ising_proj[:, 0], ising_proj[:, 1], c=label_ising, cmap='coolwarm', s=20)\n",
    "plt.colorbar(label='Temperature $T$')\n",
    "plt.xlabel('Principal Component 1')\n",
    "plt.ylabel('Principal Component 2')\n",
    "plt.title('Ising Model PCA')\n",
    "plt.show()"
   ]
