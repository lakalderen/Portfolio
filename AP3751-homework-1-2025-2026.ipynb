import numpy as np
from scipy import linalg as la
import matplotlib.pyplot as plt

#30x30 square lattices so we have 900 sins in 1 lattice and 1000 sample

#upload data, use AI some of the format was off 
directory = "/Users/lilly-anne/Desktop/ap3751-2026-kalderen"
config_ising = np.load(f"{directory}/ising_training_configs_30x30.npy", allow_pickle=True)
label_ising = np.load(f"{directory}/ising_training_labels_30x30.npy", allow_pickle=True)

#Reshape to get the 1000 samples each with 900 pixels double checked with AI that this was done correctly 
config_reshape = config_ising.reshape(config_ising.shape[0], -1) 

#Start by standardizing the data 
mean_config = np.mean(config_reshape,axis=0)
config_standard_dev= np.std(config_reshape,axis=0)
config_standardized = (config_reshape - mean_config)/config_standard_dev

#Calculate the covariance matrix and eigenvalues
cov_matrix = np.cov(config_standardized,rowvar=False,dtype=None) 
eigen_vals, eigen_vecs = la.eigh(cov_matrix)
index  = np.argsort(eigen_vals)[::-1] #reindex so that we get the eigen values and vectors from high to low
eiegen_vals = eigen_vals[index]
eigen_vecs = eigen_vecs[:, index]

proj_matrix = eigen_vecs[:,:2] #The two eigen vectors corresponding to the highest eigenvalues used as PCAs. Checked and corrected with AI that the projection matrix was correct

ising_proj = np.dot(config_standardized,proj_matrix) #Apply the projection


#AI used to make the plots pretty
plt.scatter(ising_proj[:, 0], ising_proj[:, 1], c=label_ising, cmap='coolwarm', s=20)
plt.colorbar(label='Temperature $T$')
plt.xlabel('Principal Component 1')
plt.ylabel('Principal Component 2')
plt.title('Ising Model PCA')
plt.show()
